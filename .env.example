# --- Database (Neon Postgres) ---
# Create a project at https://console.neon.tech, copy the pooled connection
# string. Required for every DB-backed feature (progress, XP, profiles...).
DATABASE_URL=

# --- Auth (Clerk) ---
# Create an application at https://dashboard.clerk.com, copy these from
# API Keys. Required for sign-in/sign-up; without them the app runs but
# every authenticated route/page will show a "configure Clerk" state.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- AI Tutor (optional, OpenAI-compatible) ---
# Any OpenAI-compatible endpoint works (OpenAI itself, or a self-hosted
# gateway). Without this set, the AI Tutor UI renders but returns a clear
# "AI tutor not configured" response instead of a fake answer.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini

# --- Rate limiting (optional, planned) ---
# Upstash Redis — needed before AI tutor / execution endpoints go to
# production traffic. See docs/SECURITY.md "Known gaps".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
